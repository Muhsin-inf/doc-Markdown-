# ==========================================
# DocManager - Environment Example Template
# Salin file ini menjadi .env lalu sesuaikan dengan konfigurasi server / database Anda:
# cp .env.example .env
# ==========================================

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_dokumentasi
DB_USER=root
DB_PASS=

# Google OAuth 2.0 Credentials (Dapatkan dari Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth_callback.php

# Application Settings
APP_NAME=DocManager
APP_ENV=production
APP_DEBUG=false
APP_URL=https://doc.muhsin.my.id
