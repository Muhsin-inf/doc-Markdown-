# ----------------------------------------------------
# Git Ignore for DocManager (doc.muhsin.my.id)
# ----------------------------------------------------

# Environment & Secret Files (SANGAT PENTING: Jangan upload file kredensial ke GitHub)
.env
.env.*
!.env.example

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# User Uploads (Kecualikan .gitkeep agar direktori tetap ada di Git)
uploads/avatars/*
!uploads/avatars/.gitkeep

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# Logs & Temporary Files
*.log
error_log
tmp/
temp/

# Server / Local Configs
.user.ini
