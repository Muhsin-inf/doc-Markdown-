Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Jika file/folder benar-benar ada, serve langsung (asset, gambar, css, dll)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tambahkan .php dan redirect jika file tersedia (clean URL tanpa ekstensi)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]

    # Fallback: coba dengan index.php di subfolder (opsional)
    # RewriteRule ^ index.php [L]
</IfModule>

# Keamanan: larang akses langsung ke file sensitif
<FilesMatch "(\.env|\.gitignore|\.htpasswd|composer\.json|package\.json|tailwind\.config\.js)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteksi folder config & src dari akses langsung
<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
    RewriteRule ^src/ - [F,L]
    RewriteRule ^database/ - [F,L]
</IfModule>

# Compression (lebih cepat)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript text/plain
</IfModule>

# Cache untuk aset statis
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>

# Jangan tampilkan error PHP ke user (ganti dengan error.php atau pesan standar)
# php_flag display_errors off
